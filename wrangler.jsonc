{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rental-gate-crm",
  "main": "backend/worker.ts",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Unified Cloudflare Workers + Static Assets (serves Vite dist/ + /api/* on same origin)
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Free-tier friendly Cron Trigger: flushes Sheets mirror outbox & checks auto-sync every 15 minutes.
  // Can be adjusted to ["*/5 * * * *"] or ["* * * * *"] (note Neon Free Plan has 100 CU-hours/month compute quota).
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  // Public non-secret runtime defaults (secrets belong in .dev.vars locally or Cloudflare Secrets in production)
  "vars": {
    "RG_API_BASE_URL": "https://api.rentalgate.net/api",
    "PG_POOL_MAX": "3"
  }
  // Optional Hyperdrive binding for low-latency connection pooling (Workers Paid / Hyperdrive setup):
  // "hyperdrive": [
  //   {
  //     "binding": "HYPERDRIVE",
  //     "id": "REPLACE_WITH_YOUR_HYPERDRIVE_ID"
  //   }
  // ]
  // Optional R2 bucket if attachment uploads are added in the future:
  // "r2_buckets": [
  //   {
  //     "binding": "CRM_ATTACHMENTS",
  //     "bucket_name": "rental-gate-crm-attachments"
  //   }
  // ]
}
