{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60,
      "includeFiles": "{assets/js/core.js,database/schema.sql}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/sync",
      "schedule": "* * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!assets/|src/|api/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
